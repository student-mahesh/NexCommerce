# ==============================================================================
# Event-Driven E-Commerce Microservices — Environment Configuration
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=dev

# Host Port Mappings (Configured to avoid collisions with existing local services)
MYSQL_HOST_PORT=3309
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9094

# Service Ports
GATEWAY_PORT=8080
PRODUCT_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
AUTH_SERVICE_PORT=8086
FRONTEND_PORT=5173

# Inter-Service Communication (Docker/Kubernetes Service Discovery)
PRODUCT_SERVICE_URL=http://localhost:8081

# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ecommerce_master
MYSQL_USER=ecom_user
MYSQL_PASSWORD=ecom_secure_pass

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# JWT Security
# Minimum 256-bit secret key for HMAC-SHA256 signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Credentials (Replace with your Google Cloud Console credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Frontend Configuration
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
